# Copy this file to .env and fill in real values. Never commit .env.
# This file is shared by both the Node/Express backend and the FastAPI
# backend (Backend/fastapi_app/app/core/config.py reads the same file).

# Node/Express server port
PORT=3000

# Legacy Gemini-based /analyze endpoint (Backend/fastapi_app/main.py).
# NOT used by the deterministic ATS pipeline (Phases 2-13) — see
# docs/ARCHITECTURE.md's "Legacy Gemini Path" section. Optional unless
# you intend to exercise the legacy endpoint.
GEMINI_API_KEY=your-gemini-api-key-here

# JWT signing secret for the Node auth backend (Backend/Controller/authController.js).
JWT_KEY=replace-with-a-long-random-secret

# Neon/PostgreSQL connection string, shared by Prisma (Node) and
# SQLAlchemy (FastAPI, via POSTGRESQL_DATABASE_URL below). Format:
# postgresql://<user>:<password>@<host>/<database>?sslmode=require
POSTGRESQL_DATABASE_URL=postgresql://user:password@host/database?sslmode=require
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Base URL the Node backend uses to reach the FastAPI service.
FASTAPI_URL=http://127.0.0.1:8000
